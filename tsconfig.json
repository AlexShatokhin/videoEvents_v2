{
  "compilerOptions": {
    "target": "es2015",
    "module": "es2015",
    "allowJs": true,
    "jsx": "react",
    "sourceMap": true,
    "rootDir": "./",
    "importHelpers": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    // "paths": {
    //   "@hooks/*": ["react/hooks/*"],
    //   "@store/*": ["store/*"],
    //   "@constants/*": ["constants/*"],
    //   "@components/*": ["react/components/*"],
    //   "@UI/*": ["react/UI/*"],
    //   "@assets/*": ["assets/*"],
    //   "@types/*": ["types/*"]
    // },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "preserveConstEnums": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noEmitHelpers": true
  },
  "exclude": [
    "App.js",
    "App.test.js",
    "build",
    "node_modules"
  ],
  "compileOnSave": false,
  "extends": "expo/tsconfig.base"
}